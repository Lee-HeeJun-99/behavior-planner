Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: Raw LiDAR
      Size (Pixels): 2
      Style: Points
      Topic: /velodyne_points
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 80; 160; 255
      Enabled: true
      Name: Global Path
      Topic: /Planning/debug/global_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Selected Local Path
      Topic: /Planning/debug/local_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Candidate Paths
      Topic: /Planning/debug/candidate_paths
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Ego
      Topic: /Planning/debug/ego
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: UTM Obstacles
      Topic: /Visualization/obstacles_utm
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Relative LiDAR Objects
      Topic: /Visualization/lidar_relative_objects
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Behavior
      Topic: /Visualization/behavior
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 30
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Current View
    Pitch: 0.785
    Target Frame: map
    Yaw: 0.785
