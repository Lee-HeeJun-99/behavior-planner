5: +        &CallbackClass::lo_yaw_cb, cb_data, std::placeholders::_1));
5: +    lo_imu__sub =
5: +      this->create_subscription<sensor_msgs::msg::Imu>(
5: +      "/imu", UDP,
5: +      std::bind(&CallbackClass::lo_imu_cb, cb_data, std::placeholders::_1));
5: +    lo_beta_sub =
5: +      this->create_subscription<std_msgs::msg::Float64>(
