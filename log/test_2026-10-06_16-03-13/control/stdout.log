5: +    vector<double> yaws;
5: +
5: +    for (size_t i = 2; i < msg->data.size(); i += 2) {
5: +      yaws.push_back(msg->data[i]);
5: +    }
5: +
5: +    this->pl_local_path_yaw = yaws;
5: +  }
