5: +
5: +  double calc_n_get_lat_error(Point pridict_pose)
5: +  {
5: +    // 준비가 안 됐으면 404 를 돌려준다. 이유는 not_ready_reason() 으로 알 수 있다.
5: +    if (pl_local_path.size() < 2 || lo_odom.x == 0.0 || lo_odom.y == 0.0) {
5: +      return 404;
5: +    }
5: +
5: +    closest_index = 0;     // 계산 결과로 나오는 값인데 이 값도 사용된다.
5: +    double min_distance =
5: +      std::sqrt(
5: +      std::pow(
5: +        pl_local_path[0].x - pridict_pose.x,
5: +        2) + std::pow(pl_local_path[0].y - pridict_pose.y, 2));
5: +
5: +    for (size_t i = 1; i < pl_local_path.size(); i++) {
5: +      double distance =
5: +        std::sqrt(
5: +        std::pow(
5: +          pl_local_path[i].x - pridict_pose.x,
5: +          2) + std::pow(pl_local_path[i].y - pridict_pose.y, 2));
5: +      if (distance < min_distance) {
5: +        closest_index = static_cast<int>(i);
5: +        min_distance = distance;
5: +      }
5: +    }
5: +
5: +    if (min_distance > 50) {
5: +      this->path_too_far = true;
5: +      return 404;       // 경로에서 50 m 넘게 떨어짐
5: +    }
5: +    this->path_too_far = false;
5: +
5: +    // lat_error의 좌 우를 구분함. (가장 가까운 점이 경로의 마지막 점이면 그 앞 구간의 방향을 쓴다)
5: +    int seg = std::min(closest_index, static_cast<int>(pl_local_path.size()) - 2);
5: +    double l_or_r = determine_side(pl_local_path[seg + 1], pridict_pose, pl_local_path[seg]);
5: +    if (l_or_r > 0) {
5: +      min_distance = min_distance * -1;
5: +    }
5: +    return min_distance;
5: +  }
