5: +    lat_control = lat_control_ptr.get();
5: +    R_lat_control_ptr = std::make_shared<ReversePurePursuit>();
5: +    R_lat_control = R_lat_control_ptr.get();
5: +
5: +    lon_control_ptr = std::make_shared<LonController>();
5: +    lon_control = lon_control_ptr.get();
5: +
5: +    param_manage_ptr = std::make_shared<ControlGainTuning>(
5: +      cb_data, lat_control, R_lat_control,
5: +      lon_control);
5: +    param_manage = param_manage_ptr.get();
5: +    // ------------------------------------------------------</클레스들 인스턴스화>
