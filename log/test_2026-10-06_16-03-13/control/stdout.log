5: +
5: +  void timer_callback()
5: +  {
5: +    // 가독성을 위해 새로운 변수로 저장
5: +    float curr_speed = cb_data->get_speed();
5: +    float yaw = cb_data->get_yaw();
5: +    Point odom = cb_data->get_odom();
5: +    double lat_error = cb_data->calc_n_get_lat_error();
5: +    double yaw_rate = cb_data->get_yawrate();
5: +    double pd_path_yaw = cb_data->get_pd_path_yaw();
5: +    double path_curature = 0.0, curv_1 = 0.0, curv_2 = 0.0, curv_3 = 0.0;
5: +
5: +    // 위치나 경로가 준비되지 않았으면 명령을 내보내지 않는다.
5: +    // (명령이 끊기면 브릿지가 차량을 세운다.)
5: +    if (lat_error == 404 || pd_path_yaw == 404) {
5: +      if (not_ready_count_++ % (1000 / CONTROL_PERIOD_MS) == 0) {
5: +        const char * reason = cb_data->not_ready_reason();
5: +        cout << "[대기] " << (reason != nullptr ? reason : "경로 또는 위치 값이 준비되지 않았습니다") << endl;
5: +      }
5: +      return;
5: +    }
5: +    not_ready_count_ = 0;
5: +
5: +    // <계산> -----------------------------------------------------------
5: +    int changed_param_num = param_manage->set_mission_param();
5: +    int mission = cb_data->get_mission_num();
5: +
5: +    // Control Switch (플래닝의 목표 속도. -1 : 후진 | 0 : 정지 | 0 초과 : 전진 속도 m/s)
5: +    float cs = cb_data->get_control_switch();
5: +
5: +    float steer = 0.0;
5: +    int gear = vehicle::GEAR_D;
5: +
5: +    // 횡방향 계산
5: +    if (cs < 0.0) {
5: +      gear = vehicle::GEAR_R;
5: +      R_lat_control->set_R_PP_data(curr_speed, yaw, odom, cb_data->get_relative_path());
5: +      steer = R_lat_control->calc_R_PP_steer();
5: +    } else {
5: +      if (mission == MISSION_NARROW && abs(lat_error) < 0.05) {
5: +        lat_control->set_stanley_integral_val(0.0);
5: +      }
5: +      lat_control->set_stanly_data(curr_speed, pd_path_yaw, yaw, lat_error);
5: +      lat_control->set_pp_data(curr_speed, yaw, odom, cb_data->get_relative_path());
5: +      steer = lat_control->calc_combined_steer();
5: +    }
5: +
5: +    // 목표 속도 정하기
5: +    if (cs == 0) {
5: +      lon_control->set_lon_target_speed(0);
5: +    } else if (0.0 < cs && cs <= TARGET_SPEED_MAX) {
5: +      lon_control->set_lon_data(curr_speed);
5: +      lon_control->set_lon_target_speed(cs);
5: +    } else if (cs == -1) {
5: +      lon_control->set_lon_data(curr_speed);
5: +      lon_control->set_lon_target_speed(REVERSE_SPEED);
5: +    } else {
5: +      if (tick_count_ % (1000 / CONTROL_PERIOD_MS) == 0) {
5: +        cout << "[경고] /Planning/target_velocity 값이 범위를 벗어났습니다 : " << cs << endl;
5: +      }
5: +      lon_control->set_lon_data(curr_speed);
5: +      lon_control->set_lon_target_speed(FALLBACK_SPEED);
5: +    }
5: +
5: +    // 곡률에 따른 감속 (협로 2바퀴째 미션만)
5: +    if (mission == MISSION_NARROW) {
5: +      // 협로 첫 바퀴에는 곡률 데이터를 못믿는다.
5: +      // 협로 두 번째 바퀴에서만 곡률에 따른 속도제어를 한다.
5: +      curv_1 = abs(cb_data->calc_path_curvature(0.1, 1.5));       // 속도 제어시 제일 먼저 곡률을 계산해야함.
5: +      curv_2 = abs(cb_data->calc_path_curvature(0.3, 1.5));       // S 커브와 같은 구간에서 불필요한 가속을 막기 위해
5: +      curv_3 = abs(cb_data->calc_path_curvature(vehicle::STEER_DELAY, 1.5));       // 조향 지연 시간만큼 앞
5: +      path_curature = max(curv_3, max(curv_1, curv_2));
5: +      if (abs(path_curature) >= 0.1) {
5: +        param_manage->target_speed_reducing_by_curature(path_curature);
5: +      }
5: +    }
5: +
5: +    // 조향이 클 때의 감속
5: +    if (cs != -1 && abs(path_curature) < 0.1) {
5: +      param_manage->target_speed_reducing_by_steer(steer);
5: +    }
5: +
5: +    // 속도 명령과 브레이크 명령
5: +    if (cs == 0) {
5: +      acc_val.gas = 0.0;
5: +      acc_val.brake = vehicle::BRAKE_STOP;
5: +    } else if (cb_data->get_serial_sub_flag()) {
5: +      // 차량 상태를 새로 받았을 때만 다시 계산한다.
5: +      acc_val = lon_control->calc_gas_n_brake();
5: +      cb_data->set_down_serial_sub_flag();
5: +    }
5: +
5: +    if (mission == MISSION_NARROW) {
5: +      acc_val.brake = clip(acc_val.brake, vehicle::BRAKE_NARROW_MIN, vehicle::BRAKE_NARROW_MAX);
5: +    }
5: +
5: +    // ---------------------------------------------------------- </계산>
5: +    // <ros topic pub> -------------------------------------------------
5: +
5: +    // 차량 명령
5: +    std_msgs::msg::Float32MultiArray vehicle_cmd_msg;
5: +    vehicle_cmd_msg.data = {
5: +      1.0F,                                    // 0 valid  (1 = 이 명령을 따를 것)
5: +      0.0F,                                    // 1 e_stop (1 = 비상 정지)
5: +      static_cast<float>(gear),                // 2 gear   (0 P / 1 D / 2 N / 3 R)
5: +      static_cast<float>(acc_val.gas),         // 3 speed  [m/s]
5: +      steer,                                   // 4 steer  [rad] (+ = 좌회전)
5: +      static_cast<float>(acc_val.brake),       // 5 brake  [%]
5: +    };
5: +    vehicle_cmd_pub->publish(vehicle_cmd_msg);
5: +
5: +    // 분석용 토픽
5: +    Point LDpoint = cb_data->AxisTrans_rel2abs(lat_control->get_target_point());
5: +
5: +    std_msgs::msg::Float64MultiArray tmp_plot_val_msg;
5: +    tmp_plot_val_msg.data.push_back(lat_error);                            // 0  경로와의 거리 [m]
5: +    tmp_plot_val_msg.data.push_back(lon_control->get_target_speed());      // 1  목표 속도 [m/s]
5: +    tmp_plot_val_msg.data.push_back(curv_1);                               // 2  곡률 (0.1 s 앞)
5: +    tmp_plot_val_msg.data.push_back(curv_2);                               // 3  곡률 (0.3 s 앞)
5: +    tmp_plot_val_msg.data.push_back(path_curature);                        // 4  감속에 쓴 곡률
5: +    tmp_plot_val_msg.data.push_back(LDpoint.x);                            // 5  Pure Pursuit 목표점 x
5: +    tmp_plot_val_msg.data.push_back(LDpoint.y);                            // 6  Pure Pursuit 목표점 y
5: +    tmp_plot_val_msg.data.push_back(acc_val.gas);                          // 7  속도 명령 [m/s]
5: +    tmp_plot_val_msg.data.push_back(acc_val.brake);                        // 8  브레이크 명령 [%]
5: +    tmp_plot_val_msg.data.push_back(lat_control->get_stanly_steer());      // 9  Stanley 조향 [rad]
5: +    vector<double> preview_steers = lat_control->get_preview_steers();
5: +    for (size_t i = 0; i < preview_steers.size(); i++) {
5: +      tmp_plot_val_msg.data.push_back(preview_steers[i]);                  // 10 11 12  미리보기 조향 [rad]
5: +    }
5: +    tmp_plot_val_msg.data.push_back(lat_control->get_PP_steer());          // 13 Pure Pursuit 조향 [rad]
5: +
5: +    vector<Point> predic_p = cb_data->get_stanley_predict_pos();
5: +    for (size_t i = 0; i < predic_p.size(); i++) {
5: +      Point tmp_p = cb_data->AxisTrans_rel2abs(predic_p[i]);
5: +      tmp_plot_val_msg.data.push_back(tmp_p.x);                            // 14 16 18  미리보기 위치 x
5: +      tmp_plot_val_msg.data.push_back(tmp_p.y);                            // 15 17 19  미리보기 위치 y
5: +    }
5: +    tmp_plot_val_msg.data.push_back(lat_control->get_stanley_integral_val());     // 20 Stanley 적분값
5: +    tmp_plot_val_msg.data.push_back(curr_speed);                           // 21 차량 속도 [m/s]
5: +    tmp_plot_val_msg.data.push_back(steer);                                // 22 조향 명령 [rad]
5: +    tmp_data_pub->publish(tmp_plot_val_msg);
5: +
5: +    // ------------------------------------------------ </ros topic pub>
5: +    // <print> ---------------------------------------------------------
5: +
5: +    if (IS_PRINT && tick_count_ % PRINT_EVERY_N_TICKS == 0) {
5: +      cout << "==================" << endl;
5: +      cout << "mission : " << mission << " (changed_param_num : " << changed_param_num << ")" <<
5: +        endl;
5: +      cout << "yawrate : " << yaw_rate << endl;
5: +      cout << "yaw : " << yaw << endl;
5: +      cout << "lat_error : " << lat_error << endl;
5: +      cout << "LD distance : " << lat_control->get_LA_distance() << endl;
5: +      cout << "path_yaw_nearest(rad) : " << pd_path_yaw << endl;
5: +      cout << "brake cmd : " << acc_val.brake << " %" << endl
5: +           << endl;
5: +
5: +      cout << "speed cmd : " << acc_val.gas * 3.6 << "km/h (" << acc_val.gas << "m/s)" << endl;
5: +      cout << "curr_speed : " << curr_speed * 3.6 << "km/h (" << curr_speed << "m/s)" << endl;
5: +      cout << "target speed : " << lon_control->get_target_speed() * 3.6 << "km/h (" <<
5: +        lon_control->get_target_speed() << "m/s)" << endl;
5: +      cout << "steer : " << steer * 180 / M_PI << " deg (" << steer << " rad)" << endl;
5: +      cout << "PP_steer : " << lat_control->get_PP_steer() * 180 / M_PI << " deg (" <<
5: +        lat_control->get_PP_steer() << " rad)" << endl;
5: +      cout << "stanly_steer: " << lat_control->get_stanly_steer() * 180 / M_PI << " deg (" <<
5: +        lat_control->get_stanly_steer() << " rad)" << endl;
5: +    }
5: +    tick_count_++;
5: +
5: +    // ------------------------------------------------------- </print>
5: +  }
