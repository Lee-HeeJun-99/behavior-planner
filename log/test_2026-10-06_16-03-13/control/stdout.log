5: +  void pl_local_path_cb(const std_msgs::msg::Float64MultiArray::SharedPtr msg)
5: +  {
5: +    // [x0, y0, x1, y1, ...] 이므로 값이 없거나 홀수 개면 쓰지 않는다 (직전 경로 유지).
5: +    if (msg->data.empty() || msg->data.size() % 2 != 0) {
5: +      cerr << "local_path 길이가 잘못되었습니다 : " << msg->data.size() << endl;
5: +      return;
5: +    }
5: +    vector<Point> points;
5: +    vector<Point> points_abs;
5: +    if (msg->data[0] == -82.82 || msg->data[1] == -82.82) {   // [-82.82, -82.82] -> 상대경로를 보내겠다는 시그널
5: +      for (size_t i = 2; i < msg->data.size(); i += 2) {
5: +        Point point{msg->data[i], msg->data[i + 1]};
5: +        points.push_back(point);
5: +      }
5: +    } else {
5: +      // Convert the received message to a 2D vector
5: +      for (size_t i = 0; i < msg->data.size(); i += 2) {
5: +        Point point{msg->data[i], msg->data[i + 1]};
5: +
5: +        points_abs.push_back(point);
5: +
5: +        Point pl_rel = AxisTrans_abs2rel(point);
5: +        points.push_back(pl_rel);
5: +      }
5: +      this->pl_local_path_abs = points_abs;
5: +    }
5: +
5: +    this->pl_local_path = points;
5: +  }
