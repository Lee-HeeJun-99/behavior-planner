5: +  double calc_path_curvature(float time_delay = 0.0, float diff_s = 1.5)   // 1.5
5: +  {
5: +    float td = clip(time_delay, 0.1F, 2.0F);
5: +    pridict_dist = td * clip(this->speed, 2.5F, 9.0F);     // (s)*(m/s)
5: +    double second_pridict_dist = pridict_dist + diff_s;
5: +    int f_pri_yaw_index = 0;
5: +    int s_pri_yaw_index = 0;
5: +
5: +    double s = 0.0;            // 경로의 길이 (Frenet s)
5: +    double min_dist = 1e9;     // 아주 큰 값으로 초기화
5: +    double second_min_dist = 1e9;
5: +
5: +    for (size_t i = 1; i < pl_local_path.size(); i++) {
5: +      double dx = pl_local_path[i].x - pl_local_path[i - 1].x;
5: +      double dy = pl_local_path[i].y - pl_local_path[i - 1].y;
5: +      s += std::sqrt(dx * dx + dy * dy);       // 경로의 길이 누적
5: +
5: +      double f_dist = abs(s - pridict_dist);
5: +      double s_dist = abs(s - second_pridict_dist);
5: +
5: +      if (f_dist < min_dist) {
5: +        f_pri_yaw_index = static_cast<int>(i);
5: +        min_dist = f_dist;
5: +      }
5: +      if (s_dist < second_min_dist) {
5: +        s_pri_yaw_index = static_cast<int>(i);
5: +        second_min_dist = s_dist;
5: +      }
5: +    }
5: +    if (pl_local_path_yaw.empty()) {
5: +      return path_curvature;
5: +    }
5: +    // path_yaw 를 읽는 방식 때문에 yaw 개수가 경로 점 개수보다 적다. 범위를 넘지 않게 한다.
5: +    int last_yaw_index = static_cast<int>(pl_local_path_yaw.size()) - 1;
5: +    f_pri_yaw_index = std::min(f_pri_yaw_index, last_yaw_index);
5: +    s_pri_yaw_index = std::min(s_pri_yaw_index, last_yaw_index);
5: +
5: +    double yaw_diff =
5: +      -nomalize_angle(pl_local_path_yaw[f_pri_yaw_index] - pl_local_path_yaw[s_pri_yaw_index]);
5: +
5: +    double tmp_curv = yaw_diff / diff_s;
5: +    this->path_curvature = low_pass_filter(tmp_curv, pre_path_curvature, 0.9);
5: +    this->pre_path_curvature = this->path_curvature;
5: +
5: +    return path_curvature;
5: +  }
